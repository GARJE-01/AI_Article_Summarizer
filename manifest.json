{
    "manifest_version": 3,
    "name": "AI Article Summarizer Pro (Free Edition)",
    "version": "2.0.0",
    "description": "Advanced AI-powered article summarization with text enhancement, export options, and smart features. Free edition with comprehensive tools.",
    "permissions": [
        "scripting",
        "activeTab", 
        "storage",
        "tabs"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icon.png"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "run_at": "document_end"
        }
    ],
    "background": {
        "service_worker": "background.js"
    },
    "options_page": "options.html",
    "host_permissions": ["<all_urls>"],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self';"
    },
    "web_accessible_resources": [
        {
            "resources": ["libs/*"],
            "matches": ["<all_urls>"]
        }
    ]
}